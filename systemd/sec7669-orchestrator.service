[Unit]
Description=sec7669 - ATHF autonomous hunt draft orchestrator
Documentation=https://github.com/BrizoSec/sec7669
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=oneshot
User=chemch
Group=chemch
WorkingDirectory=/home/chemch/sec7669

# Read env from the .env file inside the repo. Keep secrets out of the unit.
EnvironmentFile=/home/chemch/sec7669/.env

# Run via uv so we always execute inside the project venv.
# If uv isn't on PATH for the service user, use the absolute path from `which uv`.
ExecStart=/home/chemch/.local/bin/uv run sec7669 run

TimeoutStartSec=900
StandardOutput=append:/home/chemch/agentic-threat-hunting-framework/logs/orchestrator.log
StandardError=append:/home/chemch/agentic-threat-hunting-framework/logs/orchestrator.log

# Light hardening — orchestrator needs to read/write the ATHF workspace
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/chemch/agentic-threat-hunting-framework /home/chemch/sec7669

[Install]
WantedBy=multi-user.target
