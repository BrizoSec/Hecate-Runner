[Unit]
Description=Run hecate-runner orchestrator every hour
Requires=hecate-runner-orchestrator.service

[Timer]
# Fire 2 minutes after boot, then one hour after each orchestrator activation.
OnBootSec=2min
OnUnitActiveSec=1h
Unit=hecate-runner-orchestrator.service

[Install]
WantedBy=timers.target
