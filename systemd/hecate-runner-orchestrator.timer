[Unit]
Description=Run hecate-runner orchestrator every 6 hours
Requires=hecate-runner-orchestrator.service

[Timer]
# Fire 2 minutes after boot, then every 6 hours (00:00, 06:00, 12:00, 18:00 UTC)
OnBootSec=2min
OnCalendar=*-*-* 00,06,12,18:00:00
Persistent=true
Unit=hecate-runner-orchestrator.service

[Install]
WantedBy=timers.target
