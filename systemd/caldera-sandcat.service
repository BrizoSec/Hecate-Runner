[Unit]
Description=CALDERA Sandcat Agent (isolated BAS container)
After=network.target

[Service]
Type=simple
# Run scripts/setup-bas-lab.sh once before starting this unit.
# Payload isolation is enforced by Docker, rather than user service mount settings.
ExecStart=/usr/bin/docker start --attach hecate-bas-agent
ExecStop=/usr/bin/docker stop --time 10 hecate-bas-agent
Restart=always
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
