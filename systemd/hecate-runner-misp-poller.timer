[Unit]
Description=Poll MISP for new published events every hour
Requires=hecate-runner-misp-poller.service

[Timer]
# Fire 5 minutes after boot, then hourly. Same cadence as the other pollers.
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true
Unit=hecate-runner-misp-poller.service

[Install]
WantedBy=timers.target
