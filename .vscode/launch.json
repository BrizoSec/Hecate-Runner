{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "hecate-runner: run (dry-run)",
            "type": "debugpy",
            "request": "launch",
            "module": "hecate_runner",
            "args": ["run", "--dry-run"],
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "hecate-runner: run (real)",
            "type": "debugpy",
            "request": "launch",
            "module": "hecate_runner",
            "args": ["run"],
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "hecate-runner: status",
            "type": "debugpy",
            "request": "launch",
            "module": "hecate_runner",
            "args": ["status"],
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "hecate-runner: doctor",
            "type": "debugpy",
            "request": "launch",
            "module": "hecate_runner",
            "args": ["doctor"],
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "pytest: all",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        }
    ]
}
