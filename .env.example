# -----------------------------------------------------------------------------
# hecate-runner configuration
#
# Copy this file to .env and edit for your environment.
# All values shown here are defaults except where marked REQUIRED.
# -----------------------------------------------------------------------------

# --- ATHF workspace ---------------------------------------------------------
# The path to your ATHF workspace (the directory where you ran `athf init`).
ATHF_WORKSPACE=/home/chemch/betas/Hecate-Core

# Path to the athf CLI binary. If empty, defaults to $ATHF_WORKSPACE/.venv/bin/athf
# ATHF_BIN=

# --- LLM provider -------------------------------------------------------------
# Not configured here. The LLM belongs to ATHF, and athf loads the workspace's
# own .env itself, so $ATHF_WORKSPACE/.env is the single place that applies to
# both orchestrated runs and manual `athf` invocations. Configuring it in this
# file too would silently put those two paths on different models.
# See Hecate-Core/.env.example for the provider, model and timeout settings.

# --- Orchestrator behavior --------------------------------------------------
# Max draft hunts the orchestrator will create per UTC day. Guardrail.
HECATE_RUNNER_MAX_DRAFTS_PER_DAY=4

# Hard timeout in seconds on any athf subprocess call (research or hypothesis
# each get their own budget — this is per-call, not a shared total).
HECATE_RUNNER_LLM_TIMEOUT_SEC=600

# Run `athf research new` (web-grounded 5-skill research) before hypothesis
# generation. Mandatory when true: a research failure/timeout aborts the
# cycle (refunds the quota, leaves CTI queued for retry) instead of falling
# back to an ungrounded hypothesis. `athf eval` measured ungrounded
# generation at ~30% accuracy on known-answer MITRE technique fixtures, so
# there's no safe silent fallback here. Set to false to explicitly opt out
# of research and always generate ungrounded (e.g. offline testing) — a
# deliberate choice, different from a research call failing mid-cycle.
HECATE_RUNNER_RESEARCH_ENABLED=true

# basic (~5 min) or advanced (~15-20 min). Keep to basic for an unattended
# timer-driven loop unless you've also raised HECATE_RUNNER_LLM_TIMEOUT_SEC.
HECATE_RUNNER_RESEARCH_DEPTH=basic

# CTI provider used by `hecate-runner run`. "file" (default) reads cti_queue/next.txt;
# "otx" pulls directly from AlienVault OTX; "rss" pulls directly from the
# configured RSS feeds; "misp" pulls from a MISP instance. "multi" fans out
# across several of these at once (see HECATE_RUNNER_CTI_MULTI_PROVIDERS below) —
# each cycle round-robins which source gets first pick, so RSS's ten feeds
# can't crowd out a slower source like MISP.
HECATE_RUNNER_CTI_PROVIDER=file

# Sub-providers to combine when HECATE_RUNNER_CTI_PROVIDER=multi, comma-separated,
# from: file, otx, rss, misp. Each needs its own section below configured
# (e.g. "rss,otx,misp" needs OTX_API_KEY and MISP_BASE_URL/MISP_API_KEY set,
# in addition to RSS's feed list, which has a working default).
# HECATE_RUNNER_CTI_MULTI_PROVIDERS=rss,otx,misp

# Log level — DEBUG, INFO, WARNING, ERROR
HECATE_RUNNER_LOG_LEVEL=INFO

# --- CTI provider: file (default) -------------------------------------------
# Directory holding the CTI intake queue. Defaults to $ATHF_WORKSPACE/cti_queue
# HECATE_RUNNER_CTI_QUEUE_DIR=

# --- Query execution ("propose, don't run") ----------------------------------
# Backend for `hecate-runner approve`. "mock" touches nothing real -- keep this
# until real data-source access exists. "splunk" shells out to
# `athf splunk search` and requires SPLUNK_HOST/SPLUNK_TOKEN in the ATHF
# workspace .env (see ATHF's own docs for those). Unvalidated against a real
# Splunk instance as of this writing -- switching is a config change, but
# verify with `athf splunk test` before trusting `hecate-runner approve` against it.
HECATE_RUNNER_QUERY_PROVIDER=mock

# Hard ceilings re-checked at both `propose` and `approve` time. Match
# AGENTS.md's Query Guardrails section.
HECATE_RUNNER_MAX_QUERY_TIME_RANGE_DAYS=7
HECATE_RUNNER_MAX_QUERY_LIMIT=1000

# --- Notifications -----------------------------------------------------------
# Slack incoming webhook URL. When set, posts a message every time the
# orchestrator creates a draft hunt. Unset = no-op, not an error.
# Create one at https://api.slack.com/messaging/webhooks
# HECATE_RUNNER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Web search for research grounding -----------------------------------------
# Not configured here either: the web search runs inside athf, so its key is set
# in $ATHF_WORKSPACE/.env alongside the LLM settings. Without it,
# HECATE_RUNNER_RESEARCH_ENABLED=true still runs `athf research new`, but it
# skips the adversary-tradecraft web-search skill. `hecate-runner doctor`
# reports whether the workspace has the key, so you can check from here.

# --- AlienVault OTX -----------------------------------------------------------
# Free-tier API key from https://otx.alienvault.com/settings — required both
# for HECATE_RUNNER_CTI_PROVIDER=otx and for `hecate-runner otx-poll` (a manual
# one-shot that stages a pulse into the file queue; there is no poller unit).
# OTX_API_KEY=

# Tuning knobs for the OTX provider/poller — defaults are usually fine.
# HECATE_RUNNER_OTX_BASE_URL=https://otx.alienvault.com
# HECATE_RUNNER_OTX_PAGE_LIMIT=20
# HECATE_RUNNER_OTX_MAX_PULSE_AGE_DAYS=30
# HECATE_RUNNER_OTX_REQUEST_TIMEOUT_SEC=30

# --- RSS/Atom CTI provider -----------------------------------------------------
# No API key required — comma-separated feed URLs. Defaults to four verified,
# reputable security research blogs (The DFIR Report, Talos, Unit42, Microsoft
# Security Blog); this is a curation choice, not a technical requirement, so
# swap freely. CISA's advisory feed was tried and excluded: it 403s on
# automated requests on every path tried, with or without a browser User-Agent.
# HECATE_RUNNER_RSS_FEED_URLS=https://thedfirreport.com/feed/,https://blog.talosintelligence.com/rss/,https://unit42.paloaltonetworks.com/feed/,https://www.microsoft.com/en-us/security/blog/feed/

# Ignore RSS entries older than this. Unlike OTX's TLP/ATT&CK-mapping filter,
# feed curation itself is the main "high signal" filter here — every URL in
# the list is hand-picked, not an open subscription firehose.
# HECATE_RUNNER_RSS_MAX_ENTRY_AGE_DAYS=30
# HECATE_RUNNER_RSS_REQUEST_TIMEOUT_SEC=30

# --- MISP CTI provider -----------------------------------------------------
# Base URL and Auth key for a MISP instance. Required for cti_provider=misp
# and `hecate-runner misp-poll`. Use a dedicated automation key (Administration ->
# List Auth Keys -> Add authentication key in the MISP UI), not a personal
# user's key.
# MISP_BASE_URL=https://localhost:8443
# MISP_API_KEY=

# Set to false only for self-signed dev/test instances (e.g. a local
# misp-docker deployment) -- keep true for any MISP with a real certificate.
# HECATE_RUNNER_MISP_VERIFY_SSL=true

# Only route events carrying a galaxy cluster. Galaxy presence separates a
# curated, analyst-written event from a bulk indicator dump -- dumps describe
# no behavior, so they can only ever produce indicator-sweep drafts with no
# ATT&CK mapping. Set false for an instance that does not tag galaxies at all,
# otherwise the provider will correctly find nothing to route.
# HECATE_RUNNER_MISP_REQUIRE_GALAXY=true

# Comma-separated MISP organisation names; only events from these orgs are
# routable. Empty (the default) means every org is eligible. REQUIRE_GALAXY
# tells curated events from dumps, but it cannot tell a high-volume curated
# feed from the few analyst-written events beside it -- on the reference
# instance one org holds 856 of 872 routable events, enough to bury the rest
# for a year at any sane drafts-per-day. Matched case-insensitively against
# the authoring org (Orgc), so it still works on a synced instance.
# This RESTRICTS, it does not rank: excluded events are walked past for good,
# because the cursor advances over them. Widen the list before a backfill
# rather than after, or reseed the cursor to revisit what was skipped.
# HECATE_RUNNER_MISP_ORG_ALLOWLIST=

# Ignore events published before this many days ago.
# HECATE_RUNNER_MISP_MAX_EVENT_AGE_DAYS=30

# Drop the freshness floor above and walk the archive oldest-first, for an
# instance whose curated events predate it. Seed .misp_cursor_state.json to
# choose where the walk starts. The cursor advances each poll and converges
# back into normal behavior on reaching the present -- turn this off then,
# since with it on a lost cursor restarts from the beginning of the archive.
# HECATE_RUNNER_MISP_BACKFILL=false

# How many event pages one poll may walk before giving up. A run of rejected
# events longer than one page is normal on an instance carrying a daily dump
# feed; pages are fetched metadata-only, so the cost is small.
# HECATE_RUNNER_MISP_MAX_PAGES_PER_POLL=25
# HECATE_RUNNER_MISP_PAGE_LIMIT=20
# HECATE_RUNNER_MISP_REQUEST_TIMEOUT_SEC=30
